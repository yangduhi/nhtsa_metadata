{
  "meta_info": {
    "title": "NHTSA Barrier Load-Cell Instrumentation Classification Configuration",
    "version": "2.2.1-db2011plus-shape-normalized-final",
    "last_updated": "2026-05-03",
    "status": "final_project_configuration_machine_executable",
    "scope": "Barrier-side load-cell metadata classification for the in-repo 2011+ metadata-only catalog. Includes flat/load-cell wall barriers and side pole load-cell barriers.",
    "not_a_single_official_nhtsa_standard": true,
    "supersedes": "NHTSA Barrier Load-Cell Instrumentation Classification Configuration v2.2.0-db2011plus-mask-aware-final",
    "primary_design_change": "Keep the v2.2.0 mask-aware rule set and add an explicit barrier shape normalization/alias policy so strict machine execution reproduces the intended 1,137/1,137 DB coverage without relying on informal interpretation."
  },
  "source_policy": {
    "local_database": "data/full_2011plus_metadata_only_refresh_2026-05-03.sqlite",
    "database_scope": "2011+ metadata-only catalog; no live NHTSA API dependency for classification closure.",
    "raw_loma_string_available_in_db": false,
    "primary_db_fields": [
      "barriers.shape",
      "SENTYPD",
      "SENATTD",
      "AXISD",
      "YTYPE",
      "YUNITSD",
      "INSCOM",
      "sensor_attachment",
      "sensor_axis",
      "unit_raw"
    ],
    "canonical_loma_generation": {
      "enabled": true,
      "used_after_primary_classification": true,
      "used_for_primary_db_matching": false,
      "reason": "Current DB does not store ISO-MME/LOMA-style names; names such as 00LOMA110100FO1P must be generated from parsed metadata if needed."
    },
    "excluded_from_barrier_load_cell_classification": [
      "dummy/body load cells where no barrier participant exists",
      "neck load cells",
      "femur load cells",
      "lumbar spine load cells",
      "abdomen load cells",
      "face load cells in sled/body tests without barrier row"
    ],
    "strict_machine_execution_requires_shape_normalization": true,
    "shape_normalization_applies_before_rule_matching": true,
    "unconditional_other_shape_aliasing_forbidden": true
  },
  "shape_normalization_policy": {
    "purpose": "Normalize DB raw barriers.shape values before applying classification rules. The v2.2.0 rules are semantically sufficient, but strict exact matching against raw barriers.shape leaves 10 alias cases unclassified. v2.2.1 makes the alias layer explicit.",
    "apply_before_classification_rules": true,
    "raw_shape_preprocessing": {
      "trim": true,
      "uppercase": true,
      "collapse_internal_whitespace": true,
      "preserve_raw_value_in_output": true
    },
    "match_field_for_rules": "normalized_barrier_shape_key",
    "rule_field": "shape_match.allowed_normalized_keys",
    "output_fields_required": [
      "raw_barrier_shape",
      "normalized_barrier_shape_key",
      "shape_alias_rule_id",
      "shape_alias_confidence",
      "shape_alias_evidence",
      "shape_alias_is_conditional"
    ],
    "unconditional_aliases": [
      {
        "alias_id": "load_cell_barrier_wall_unconditional",
        "normalized_barrier_shape_key": "LOAD_CELL_BARRIER",
        "raw_values": [
          "LOAD CELL BARRIER",
          "8 X 16 + 6 LOAD CELL BARRIER",
          "8 X 16 LOAD CELL BARRIER"
        ],
        "allowed_families": [
          "frontal_or_flat_load_cell_wall"
        ],
        "rationale": "All listed raw values explicitly indicate a load-cell barrier wall. Final assignment is still controlled by attachment pattern and occupancy signature."
      },
      {
        "alias_id": "pole_barrier_unconditional",
        "normalized_barrier_shape_key": "POLE",
        "raw_values": [
          "POLE"
        ],
        "allowed_families": [
          "side_pole_load_cell_barrier"
        ],
        "rationale": "POLE is the DB raw shape for side pole load-cell barrier tests."
      }
    ],
    "conditional_aliases": [
      {
        "alias_id": "flat_barrier_legacy_4x9_load_cell",
        "raw_values": [
          "FLAT BARRIER"
        ],
        "normalized_barrier_shape_key": "FLAT_BARRIER_LEGACY_LOAD_CELL",
        "allowed_rules": [
          "legacy_4x9_us_ncap"
        ],
        "conditions_all": [
          "sensor_type is LOAD CELL",
          "attachment pattern matches ^LOAD CELL (?P<row_letter>[A-D])(?P<col>[1-9])$",
          "observed force channel count equals 36",
          "row letters are A-D and columns are 1-9",
          "no pole attachment pattern is present for the same barrier participant"
        ],
        "observed_current_db": {
          "test_count": 2,
          "test_numbers": [
            9662,
            9989
          ]
        },
        "do_not_global_alias_raw_shape": true,
        "rationale": "FLAT BARRIER is a generic raw shape; only legacy 4x9 load-cell attachment occupancy makes it a load-cell wall case."
      },
      {
        "alias_id": "other_high_resolution_load_cell_barrier_by_evidence",
        "raw_values": [
          "OTHER"
        ],
        "normalized_barrier_shape_key": "OTHER_LOAD_CELL_BARRIER_REVIEWED",
        "allowed_rules": [
          "extended_height_10x16_160"
        ],
        "conditions_all": [
          "sensor_type is LOAD CELL",
          "attachment pattern matches ^LOAD CELL ROW (?P<row>\\d+) COLUMN (?P<col>\\d+)$",
          "observed force channel count equals 160",
          "observed row range is 2-11 and observed column range is 1-16",
          "title/commentary/INSCOM or reviewed metadata contains load-cell barrier evidence"
        ],
        "observed_current_db": {
          "test_count": 1,
          "test_numbers": [
            8603
          ]
        },
        "do_not_global_alias_raw_shape": true,
        "rationale": "OTHER is not a load-cell barrier shape by itself. It may be accepted only when independent title/commentary evidence and row/column occupancy both match a known load-cell wall rule."
      }
    ],
    "forbidden_global_aliases": [
      {
        "raw_shape": "OTHER",
        "forbidden_normalized_key": "LOAD_CELL_BARRIER",
        "reason": "OTHER is too broad; accepting it globally would create false positives outside reviewed load-cell-barrier cases."
      },
      {
        "raw_shape": "FLAT BARRIER",
        "forbidden_normalized_key": "LOAD_CELL_BARRIER",
        "reason": "FLAT BARRIER is generic; accept it only for the legacy 4x9 load-cell occupancy signature."
      }
    ],
    "db2011plus_alias_cases_required_for_v2_2_1_closure": [
      {
