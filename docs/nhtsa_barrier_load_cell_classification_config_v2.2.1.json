    "db_observed": "Observed in the local 2011+ metadata-only DB review.",
    "dataset_inferred": "Inferred from local DB patterns; requires report-specific verification for physical geometry claims.",
    "external_candidate": "Kept only as a possible external/report-specific candidate; not observed in the current local DB.",
    "deprecated_or_rejected": "Rejected for this DB/configuration because it is unsafe, unsupported, or overly broad."
  },
