    },
    "validation_checks": [
        "No barrier-side load-cell channel should remain unclassified except explicit exclusions.",
        "Every classified wall-grid test must emit an occupancy map.",
        "Every classified pole test must emit pole_index coverage plus duplicate/missing masks.",
        "No force_count-only assignment is allowed without row/column or pole-index evidence.",
        "Rows/columns must remain raw until canonical orientation is explicitly assigned.",
        "CoP calculations must fail or emit NaN when required moment channels are missing, rather than assuming geometric center for physics calculations.",
        "Fixed model tensors must include padding and validity masks."
    ]
}
