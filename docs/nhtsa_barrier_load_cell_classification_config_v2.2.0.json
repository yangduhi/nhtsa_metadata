{
    "meta_info": {
        "title": "NHTSA Barrier Load-Cell Instrumentation Classification Configuration",
        "version": "2.2.0-db2011plus-mask-aware-final",
        "last_updated": "2026-05-03",
        "status": "final_project_configuration",
        "scope": "Barrier-side load-cell metadata classification for the in-repo 2011+ metadata-only catalog. Includes flat/load-cell wall barriers and side pole load-cell barriers.",
        "not_a_single_official_nhtsa_standard": true,
        "supersedes": "NHTSA Frontal Rigid Barrier Load Cell Master Configuration v2.1.0",
        "primary_design_change": "Replace force-count-only wall-grid classification with barrier_shape + attachment pattern + quantity/unit + parsed occupancy + mask-aware classification."
    },
    "source_policy": {
        "local_database": "data/full_2011plus_metadata_only_refresh_2026-05-03.sqlite",
        "database_scope": "2011+ metadata-only catalog; no live NHTSA API dependency for classification closure.",
        "raw_loma_string_available_in_db": false,
        "primary_db_fields": [
            "barriers.shape",
            "SENTYPD",
            "SENATTD",
            "AXISD",
            "YTYPE",
            "YUNITSD",
            "INSCOM",
            "sensor_attachment",
            "sensor_axis",
            "unit_raw"
        ],
        "canonical_loma_generation": {
            "enabled": true,
            "used_after_primary_classification": true,
            "used_for_primary_db_matching": false,
            "reason": "Current DB does not store ISO-MME/LOMA-style names; names such as 00LOMA110100FO1P must be generated from parsed metadata if needed."
        },
        "excluded_from_barrier_load_cell_classification": [
            "dummy/body load cells where no barrier participant exists",
            "neck load cells",
            "femur load cells",
            "lumbar spine load cells",
            "abdomen load cells",
            "face load cells in sled/body tests without barrier row"
        ]
    },
    "reference_status_levels": {
        "official_reference": "Supported by public NHTSA documents or NHTSA research material.",
        "db_observed": "Observed in the local 2011+ metadata-only DB review.",
        "dataset_inferred": "Inferred from local DB patterns; requires report-specific verification for physical geometry claims.",
        "external_candidate": "Kept only as a possible external/report-specific candidate; not observed in the current local DB.",
        "deprecated_or_rejected": "Rejected for this DB/configuration because it is unsafe, unsupported, or overly broad."
    },
    "physical_specifications": {
        "unit_system": {
            "length": "mm",
            "force": "kN",
            "moment": "kN*m"
        },
        "geometry_source_priority": [
            "test_report_datasheet_geometry",
            "barriers.shape plus parsed attachment occupancy",
            "known NHTSA research reference geometry",
            "project canonical default"
        ],
        "known_reference_geometries": {
            "legacy_4x9_us_ncap": {
                "rows": 4,
                "cols": 9,
                "width_mm": 2108.2,
                "height_mm": 984.25,
                "source_status": "official_reference"
            },
            "high_res_8x16": {
                "rows": 8,
                "cols": 16,
                "width_mm": 2000.0,
                "height_mm": 1000.0,
                "cell_pitch_mm": 125.0,
                "source_status": "official_reference"
            },
            "high_res_8x16_plus_6_partial_row": {
                "base_rows": 8,
                "base_cols": 16,
                "additional_partial_row_cell_count": 6,
                "cell_pitch_mm": 125.0,
                "source_status": "official_reference_and_db_observed"
            }
        },
        "cell_geometry_policy": {
            "do_not_assume_all_reports_use_identical_cell_face_dimensions": true,
            "canonical_pitch_mm": 125.0,
            "use_cell_face_gap_pitch_separately_when_reported": true,
            "required_output_metadata": [
                "geometry_source",
                "rows_observed",
                "cols_observed",
                "row_range_observed",
                "col_range_observed",
                "cell_pitch_mm_or_null",
                "physical_width_mm_or_null",
                "physical_height_mm_or_null"
            ]
        }
    },
    "coordinate_and_orientation_policy": {
        "principle": "Do not treat raw DB row numbering as a universal bottom-to-top physical coordinate. Store raw row/column indices and a separately transformed canonical analysis frame.",
        "raw_frame": {
            "source": "DB/report metadata and NHTSA data coordinate conventions",
            "row_orientation": "test_report_or_dataset_specific",
            "column_orientation": "test_report_or_dataset_specific",
            "do_not_hardcode_origin": "Bottom-Left Row 01 Col 01"
        },
        "canonical_analysis_frame": {
            "origin": "bottom_left_after_verified_transform",
            "row_index": "zero_based_bottom_to_top_after_transform",
            "col_index": "zero_based_left_to_right_after_transform",
            "x": "compression_positive_after_sign_normalization",
            "y": "project_defined_lateral_axis_after_transform",
            "z": "positive_up_after_transform"
        },
        "orientation_validation": {
            "allowed_methods": [
                "test_report_datasheet",
                "known barrier_shape geometry",
                "occupancy map row/column extents",
                "physically plausible AHOF/centroid after sign/orientation transform"
            ],
            "forbidden_methods": [
                "blind vertical flip based only on passenger-car centroid threshold",
                "classifying Row 11 as auxiliary solely by row number"
            ]
        }
    },
    "channel_identifier_policy": {
        "raw_db_classification": {
            "sensor_type_filter": "sensor_type == LOAD CELL or SENTYPD indicating LOAD CELL",
            "barrier_participant_required": true,
            "barrier_shape_field": "barriers.shape",
            "attachment_field_preferred": "sensor_attachment",
            "attachment_field_raw": "SENATTD",
            "axis_field_preferred": "sensor_axis",
            "axis_field_raw": "AXISD",
            "quantity_fields": [
                "YTYPE",
                "YUNITSD",
                "unit_raw"
            ],
            "commentary_field": "INSCOM"
        },
        "attachment_parsers": {
            "legacy_4x9": "^LOAD CELL (?P<row_letter>[A-D])(?P<col>[1-9])$",
            "row_column_wall": "^LOAD CELL ROW (?P<row>\\d+) COLUMN (?P<col>\\d+)$",
            "pole_modern": "^LOAD CELL POLE (?P<pole_index>\\d+)$",
            "pole_legacy_attachment": "^POLE$",
            "pole_legacy_inscom": "LOAD CELL (?P<pole_index>\\d+)"
        },
        "generated_loma_name": {
            "pattern": "^(?P<object>\\d{2})(?P<device>LOMA)(?P<row>\\d{2})(?P<col>\\d{2})(?P<fine>\\d{2})(?P<quantity>FO|MO)(?P<axis>[123])(?P<polarity>[PN])$",
            "example": "00LOMA110100FO1P",
            "parsed_example": {
                "object": "00",
                "device": "LOMA",
                "row": 11,
                "col": 1,
                "fine": "00",
                "quantity": "FO",
                "axis": 1,
                "polarity": "P"
            },
            "status": "generated_canonical_name_only_not_raw_db_key"
        }
    },
    "quantity_mapping_policy": {
        "force_quantity_detection": {
            "required_quantity": "FORCE",
            "accepted_units": [
                "kN",
                "N",
                "lbf",
                "unit_raw_force_equivalent"
            ],
            "normalization_target_unit": "kN"
        },
        "moment_quantity_detection": {
            "accepted_units": [
                "kN*m",
                "N*m",
                "lbf*ft",
                "unit_raw_moment_equivalent"
            ],
            "normalization_target_unit": "kN*m",
            "moment_channels_optional": true
        },
        "axis_mapping": {
            "preserve_raw_axis_first": true,
            "wall_default_candidates": {
                "FO1_or_force_axis_1": "Fx_candidate",
                "MO2_or_moment_axis_2": "My_candidate",
                "MO3_or_moment_axis_3": "Mz_candidate"
            },
            "pole_default_candidates": {
                "force_axis": "preserve_raw_axis; define canonical pole-normal only after report/axis validation"
            },
            "requires_sign_validation": true
        }
    },
    "classification_strategy": {
        "do_not_use_count_only": true,
        "primary_features": [
            "barriers.shape",
            "attachment pattern",
            "parsed row/column or pole index",
            "YTYPE/YUNITSD/unit_raw quantity",
            "force channel count",
            "moment channel availability",
            "occupancy map",
            "missing/duplicate channel map"
        ],
        "classification_order": [
            "exclude non-barrier body/dummy load cells",
            "identify barrier shape",
            "parse attachment pattern",
            "separate wall-grid from pole family",
            "derive occupancy map from row/column or pole index",
            "validate force/moment counts against candidate rule",
            "assign masks for missing, duplicate, inactive, padding, and physical cells",
            "emit classification id plus confidence/status"
        ]
    },
