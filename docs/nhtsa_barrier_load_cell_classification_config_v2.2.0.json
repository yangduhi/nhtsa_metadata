    "inactive_or_external_candidate_rules": [
        {
            "id": "wide_8x22_176",
            "status": "not_observed_in_current_2011plus_db",
            "activation_policy": "Activate only when parsed row/column extent is 8x22 or report-specific geometry verifies 8x22. Do not infer from force_count=176 alone because 11x16 also has 176 cells.",
            "source_status": "external_candidate"
        },
        {
            "id": "large_lcw_288",
            "status": "not_observed_in_current_2011plus_db",
            "activation_policy": "Activate only with report-specific geometry or DB occupancy extent matching a 288-cell LCW.",
            "source_status": "external_candidate"
        }
    ],
    "deprecated_or_rejected_rules": [
        {
            "id": "count_only_force_channel_detection",
            "reason": "Ambiguous and insufficient. Example: 176 force channels can be 11x16 or 8x22 depending on row/column extents."
        },
        {
            "id": "row_11_always_auxiliary",
            "reason": "Unsafe. Row 11 may be a physical row in observed DB wall-grid families. Classify auxiliary status from metadata/occupancy/report evidence, not row number alone."
        },
        {
            "id": "moment_missing_zero_for_physics",
            "reason": "Unsafe for CoP and stiffness calculations. Use NaN plus validity masks; zero padding is allowed only for model input with masks."
        },
        {
            "id": "raw_loma_primary_parser_for_current_db",
            "reason": "Current DB contains no raw LOMA strings. LOMA-compatible names may be generated after classification."
        },
        {
            "id": "legacy_4x9_physical_size_2250x1000",
            "reason": "Replace with NHTSA research reference geometry 2108.2 x 984.25 mm for US NCAP 4x9 LCW unless a test report states otherwise."
        }
    ],
    "mask_policy": {
        "physical_cell": "Cell exists in the declared/report-inferred physical barrier layout.",
        "active_channel": "A measured channel exists in the DB for the cell or pole index.",
        "valid_force": "Force channel is present, unit-normalized, and not invalidated by status/quality rules.",
        "valid_Fx": "Wall-normal or canonical compression force channel is present after axis/sign validation.",
        "valid_My": "Moment about canonical y axis is present after axis/sign validation.",
        "valid_Mz": "Moment about canonical z axis is present after axis/sign validation.",
        "missing_expected_channel": "A cell expected by the nominal geometry is absent in the observed DB channels.",
        "inactive_physical_cell": "Physical cell exists but is not an active measured cell in the observed configuration.",
        "duplicate_channel": "More than one channel maps to the same expected pole/cell/quantity/axis slot.",
        "padding": "Tensor slot inserted for shape alignment, not a measured channel."
    },
    "tensor_policy": {
        "preferred": "dynamic_shape_with_masks",
        "fixed_shape_allowed": true,
        "fixed_shape_is_model_specific_not_nhtsa_standard": true,
        "wall_tensor_channels": [
            "Fx",
            "My",
            "Mz"
        ],
        "pole_tensor_channels": [
            "force_raw_axis_or_canonical_pole_normal_after_validation"
        ],
        "silent_crop_forbidden": true,
        "zero_padding_allowed_only_with_padding_mask": true,
        "moment_missing_value_for_physical_calculation": "NaN",
        "force_missing_value_for_physical_calculation": "NaN",
        "required_metadata": [
            "classification_id",
            "classification_status",
            "rows_original",
            "cols_original",
            "row_range_raw",
            "col_range_raw",
            "row_offset_applied",
            "col_offset_applied",
            "geometry_source",
            "orientation_source",
            "axis_sign_validation_status"
        ]
    },
    "calculation_policy": {
        "total_force": {
            "formula": "sum(valid canonical compression force channels)",
            "exclude": [
                "moments",
                "invalid force channels",
                "padding slots",
                "duplicate channels unless explicitly resolved",
                "non-barrier dummy/body load cells"
            ]
        },
        "ahof": {
            "formula": "sum(F_i * H_i) / sum(F_i)",
            "requires": [
                "valid force",
                "height coordinate for each active physical cell",
                "geometry source",
                "orientation source"
            ],
            "note": "AHOF can be calculated from force grid and cell heights; moment channels are not required. Do not compare 4x9 and 8x16 AHOF without resolution caveat."
        },
        "center_of_pressure": {
            "unit_rule": "kN*m divided by kN gives meters; multiply by 1000 before adding to mm coordinates.",
            "index_rule": "Use zero-based canonical row/column indices after orientation transform.",
            "z_center_mm": "z_origin_mm + (row0 + 0.5) * pitch_z_mm",
            "y_center_mm": "y_origin_mm + (col0 + 0.5) * pitch_y_mm",
            "z_cop_mm": "z_center_mm + sign_my * 1000 * My_kNm / Fx_kN",
            "y_cop_mm": "y_center_mm + sign_mz * 1000 * Mz_kNm / Fx_kN",
            "validity": [
                "abs(Fx_kN) > threshold",
                "valid_My and/or valid_Mz present for axis-specific CoP",
                "local CoP offset physically plausible",
                "axis and sign validation completed"
            ],
            "default_abs_Fx_kN_threshold": 0.5
        }
    },
    "metadata_scaling_policy": {
        "principle": "Do not silently rescale vehicle or barrier metadata. Store raw value, corrected value, unit inference, rule, and confidence.",
        "vehicle_width_mm": {
            "valid_range_mm": [
                1200,
                2600
            ],
            "if_value_gt_10000": "candidate divide_by_10 only with audit log and confidence flag"
        },
        "vehicle_mass_kg": {
            "valid_range_kg": [
                500,
                6000
            ],
            "if_value_gt_10000": "try known 0.1 kg encoding or lb-to-kg conversion only if unit evidence exists; otherwise flag invalid"
        },
        "audit_fields_required": [
            "field_name",
            "raw_value",
            "corrected_value",
            "raw_unit_or_null",
            "corrected_unit",
            "correction_rule",
            "confidence"
        ]
    },
